{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownKit",
  "version": "0.1.0",
  "identifier": "com.tyrelld1.markdownkit",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MarkdownKit",
        "width": 920,
        "height": 820,
        "minWidth": 560,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#f7f6f3",
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost http://asset.localhost https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A calm markdown viewer for macOS",
    "longDescription": "MarkdownKit is a lightweight local markdown viewer with a Notion-like reading layout. It parses files natively, uses almost no CPU while idle, and can open .md files from Finder.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Default",
        "exportedType": {
          "identifier": "com.tyrelld1.markdownkit.markdown",
          "conformsTo": ["public.plain-text", "public.text"]
        }
      },
      {
        "ext": ["md"],
        "name": "Markdown",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Default",
        "contentTypes": ["net.daringfireball.markdown"]
      }
    ]
  }
}
